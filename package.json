{
  "name": "ruralconnect-ai",
  "version": "1.0.0",
  "description": "AI-powered mobile application empowering rural communities in India",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @ruralconnect/mobile start",
    "mobile:android": "yarn workspace @ruralconnect/mobile android",
    "mobile:ios": "yarn workspace @ruralconnect/mobile ios",
    "mobile:test": "yarn workspace @ruralconnect/mobile test",
    "mobile:lint": "yarn workspace @ruralconnect/mobile lint",
    "mobile:type-check": "yarn workspace @ruralconnect/mobile type-check",
    "backend": "yarn workspace @ruralconnect/backend dev",
    "ml": "cd packages/ml-services && python -m uvicorn main:app --reload",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "build": "yarn workspaces run build"
  },
  "keywords": [
    "rural",
    "agriculture",
    "healthcare",
    "education",
    "infrastructure",
    "ai",
    "aws",
    "bedrock"
  ],
  "dependencies": {
    "metro": "0.80.12",
    "metro-runtime": "0.80.12"
  },
  "author": "RuralConnect AI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
