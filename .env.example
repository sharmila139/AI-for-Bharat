# RuralConnect AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Amazon S3 Buckets
# ============================================
S3_STATIC_BUCKET=ruralconnect-static-assets-ACCOUNT_ID
S3_UPLOADS_BUCKET=ruralconnect-user-uploads-ACCOUNT_ID
S3_BACKUPS_BUCKET=ruralconnect-backups-ACCOUNT_ID
S3_ML_BUCKET=ruralconnect-ml-models-ACCOUNT_ID
S3_LOGS_BUCKET=ruralconnect-logs-ACCOUNT_ID

# ============================================
# Amazon CloudFront
# ============================================
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
CLOUDFRONT_DOMAIN=your-distribution.cloudfront.net
CDN_URL=https://your-distribution.cloudfront.net

# ============================================
# Amazon RDS PostgreSQL
# ============================================
DATABASE_URL=postgresql://admin:PASSWORD@endpoint:5432/ruralconnect
DATABASE_REPLICA_URL=postgresql://admin:PASSWORD@replica-endpoint:5432/ruralconnect
DB_POOL_MIN=5
DB_POOL_MAX=20

# ============================================
# Amazon DynamoDB
# ============================================
DYNAMODB_SESSIONS_TABLE=ruralconnect-sessions
DYNAMODB_CACHE_TABLE=ruralconnect-cache
DYNAMODB_NOTIFICATIONS_TABLE=ruralconnect-notifications
DYNAMODB_ANALYTICS_TABLE=ruralconnect-analytics

# ============================================
# Amazon ElastiCache Redis
# ============================================
REDIS_URL=redis://your-redis-endpoint:6379
REDIS_PASSWORD=your-redis-password
REDIS_TTL=300

# ============================================
# Amazon Bedrock
# ============================================
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# ============================================
# AWS Lambda
# ============================================
LAMBDA_FUNCTION_NAME=ruralconnect-api
LAMBDA_MEMORY=1024
LAMBDA_TIMEOUT=30

# ============================================
# AWS Secrets Manager
# ============================================
SECRET_DATABASE=ruralconnect/database
SECRET_JWT=ruralconnect/jwt
SECRET_API_KEYS=ruralconnect/api-keys

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ENCRYPTION_KEY=your-aes-256-key-32-bytes
BCRYPT_ROUNDS=10

# ============================================
# External APIs
# ============================================
# Weather APIs
IMD_API_KEY=your-imd-api-key
OPENWEATHER_API_KEY=your-openweather-api-key

# Market Data
AGMARKNET_API_KEY=your-agmarknet-api-key

# SMS Service
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# Mobile App Configuration
# ============================================
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CDN_URL=https://your-distribution.cloudfront.net
EXPO_PUBLIC_BEDROCK_ENABLED=true

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
CLOUDWATCH_LOG_GROUP=/aws/ruralconnect
SENTRY_DSN=your-sentry-dsn

# ============================================
# Feature Flags
# ============================================
ENABLE_OFFLINE_MODE=true
ENABLE_VOICE_INTERFACE=true
ENABLE_BEDROCK_AI=true
ENABLE_ANALYTICS=true
