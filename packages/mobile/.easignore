# EAS Build ignore file
# Files and directories to exclude from EAS builds

# Documentation
*.md
docs/

# Tests
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
jest.config.js
jest.setup.js

# Build artifacts
android/build/
android/app/build/
ios/build/
dist/
build/

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
.DS_Store
*.swp
*.swo
*~

# Yarn (if using npm)
.yarn/
.yarnrc.yml
yarn.lock

# Git
.git/
.gitignore
